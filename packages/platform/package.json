{
  "name": "forge-cw",
  "version": "0.1.1",
  "description": "A visual dashboard for your coding agents on Claude Code, Codex, Pi or OpenCode. Installs CW for you.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avarajar/forge.git",
    "directory": "packages/platform"
  },
  "homepage": "https://avarajar.github.io/forge/",
