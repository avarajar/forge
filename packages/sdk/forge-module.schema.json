{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/forge-module-1.json",
  "title": "Forge module manifest (SDK v1)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "sdk",
    "displayName"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sdk": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "view": {
      "type": "object",
      "required": [
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fs:read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fs:write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pty": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/setting"
          }
        }
      }
    },
    "actions": {
      "type": "array"
    },
    "detectors": {
      "type": "array"
    },
    "panels": {
      "type": "array"
    },
    "claude": {
      "type": "object"
    }
  },
  "$defs": {
    "scalar": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "enum"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "pattern": {
          "type": "string"
        },
        "format": {
          "enum": [
            "path",
            "cw-project",
            "url"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "setting": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "object",
          "required": [
            "type",
            "item"
          ],
          "properties": {
            "type": {
              "const": "list"
            },
            "label": {
              "type": "string"
            },
            "help": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "default": {
              "type": "array"
            },
            "item": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        }
      ]
    }
  }
}
