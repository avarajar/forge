{
  "name": "@forge-dev/mod-qa",
  "version": "0.2.0",
  "displayName": "Quality Assurance",
  "description": "qa-pilot escalation inbox: pull requests that need a human, with the decision's gates, checks and findings",
  "icon": "shield-check",
  "color": "#10b981",
  "panels": [
    { "id": "escalations", "title": "Escalamientos", "component": "./panels/Escalations", "default": true }
  ],
  "actions": [
    {
      "id": "list-escalations",
      "label": "List Escalations",
      "icon": "inbox",
      "command": "gh pr list --label qa:needs-human --state open --json number,title,url,updatedAt,author,headRefOid --limit 50",
      "tags": ["qa"],
      "hidden": true
    },
    {
      "id": "get-decision",
      "label": "Get Decision",
      "icon": "file-search",
      "command": "gh pr view \"$FORGE_PARAM_PR\" --json number,title,url,headRefOid,headRefName,author,comments,additions,deletions,changedFiles",
      "params": { "PR": { "pattern": "\\d+" } },
      "tags": ["qa"],
      "hidden": true
    },
    {
      "id": "week-stats",
      "label": "Week Stats",
      "icon": "bar-chart",
      "command": "gh pr list --state all --search \"updated:>=$(node -e 'process.stdout.write(new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 10))')\" --json number,labels --limit 200",
      "tags": ["qa"],
      "hidden": true
    },
    {
      "id": "approve",
      "label": "Approve",
      "icon": "check",
      "command": "gh pr edit \"$FORGE_PARAM_PR\" --add-label qa:approved",
      "params": { "PR": { "pattern": "\\d+" } },
      "tags": ["qa"],
      "hidden": true
    },
    {
      "id": "request-changes",
      "label": "Request Changes",
      "icon": "message-square",
      "command": "gh pr comment \"$FORGE_PARAM_PR\" --body \"$(printf 'Cambios pedidos desde Forge:\\n\\n%s\\n' \"$FORGE_PARAM_MSG\")\"",
      "params": {
        "PR": { "pattern": "\\d+" },
        "MSG": { "pattern": "[A-Za-z0-9À-ÿ ¿¡.,;:!?()'\"/#@_+%*=-]{1,500}" }
      },
      "tags": ["qa"],
      "hidden": true
    }
  ],
  "detectors": [
    { "tool": "qa-pilot", "files": ["qa/qa-pilot.yaml"], "suggestion": "qa-pilot contract found. Review escalated pull requests from QA." }
  ]
}
